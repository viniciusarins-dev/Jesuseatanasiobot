# Copie para .env para ativar o provedor externo de eventos.
# ATENÇÃO: variáveis VITE_* são embutidas no JavaScript do navegador.
# NUNCA coloque tokens, senhas, cookies ou chaves aqui — apenas a URL do bridge.
# O bridge (processo separado) é quem guarda credenciais, se houver.
VITE_EVENT_BRIDGE_URL=
# Exemplo: VITE_EVENT_BRIDGE_URL=ws://localhost:8787
