# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.
# Nenhum destes valores é registrado em log ou enviado ao Telegram.

# Login numérico da conta MT5 (opcional se o terminal já estiver logado;
# quando informado, o sistema confere se a conta conectada é a mesma).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Caminho do terminal64.exe (opcional; necessário se houver mais de um terminal instalado).
MT5_TERMINAL_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
